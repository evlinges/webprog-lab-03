// Prisma-схема системи обліку замовлень майстерні нагород «Rezanok».
// Предметна область перенесена з реального проєкту Rezanok:
// клієнт -> замовлення -> позиції -> виробничі стадії, а також оплати,
// доставка, склад заготовок і працівники.
//
// Продемонстровані типи звʼязків:
//   1:N   Client -> Order, Order -> OrderItem, Order -> Payment,
//         OrderItem -> ProductionStage, StockItem -> OrderItem
//   1:1   Order -> Shipment
//   M:N   Order <-> Employee (через явну таблицю звʼязку OrderAssignment)
//   опційний (nullable) FK: OrderItem.stockItemId, ProductionStage.executorId

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Перелічувані типи ───────────────────────────

enum OrderStatus {
  new // нове
  work // у роботі
  done // виконано
  problem // проблемне
}

enum OrderSource {
  instagram
  facebook
  site
  referral // за рекомендацією
  repeat // повторний клієнт
}

enum EmployeeRole {
  manager // менеджер
  designer // дизайнер
  production // виробництво
  admin // адміністратор
}

enum StageStatus {
  pending // очікує
  in_progress // у роботі
  done // готово
  skip // не потребує
}

enum PaymentMethod {
  cash // готівка
  card // картка
  bank // банківський переказ
  manual // внесено вручну
}

/// Роль користувача системи (для аутентифікації/авторизації, RBAC).
/// Окрема від EmployeeRole: та описує виробничу роль працівника майстерні,
/// а ця — рівень доступу до API.
enum UserRole {
  user // звичайний користувач (менеджер): читання + свої дані
  admin // адміністратор: повний доступ, зокрема видалення
}

/// Тип сповіщення (для групування та фільтрації на клієнті).
enum NotificationType {
  order // події замовлень
  payment // оплати
  production // виробничі стадії
  system // системні
}

/// Пріоритет сповіщення.
enum NotificationPriority {
  low
  normal
  high
}

// ─────────────────────────────── Сутності ────────────────────────────────

/// Клієнт (замовник). Один клієнт — багато замовлень (1:N).
model Client {
  id        Int         @id @default(autoincrement())
  name      String
  phone     String?
  source    OrderSource?
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  orders    Order[]

  // Додано в ЛР3 під пошук клієнтів за іменем.
  @@index([name])
  @@map("clients")
}

/// Працівник майстерні. Бере участь у замовленнях (M:N) і може бути
/// виконавцем виробничих стадій (1:N).
model Employee {
  id          Int                @id @default(autoincrement())
  fullName    String             @map("full_name")
  role        EmployeeRole
  color       String             @default("#6B7280")
  initials    String             @default("?")
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now()) @map("created_at")

  assignments OrderAssignment[]
  stages      ProductionStage[]

  @@map("employees")
}

/// Позиція складу (заготовка: медаль, кубок, плакетка тощо).
/// Одна заготовка може використовуватись у багатьох позиціях замовлень (1:N).
model StockItem {
  id           Int         @id @default(autoincrement())
  groupName    String      @map("group_name")
  label        String
  dims         String?
  qty          Int         @default(0)
  lowThreshold Int         @default(0) @map("low_threshold")
  price        Decimal     @default(0) @db.Decimal(10, 2)
  createdAt    DateTime    @default(now()) @map("created_at")

  orderItems   OrderItem[]

  // Додано в ЛР3 під фільтрацію складу за групою.
  @@index([groupName])
  @@map("stock_items")
}

/// Замовлення. Центральна сутність домену.
model Order {
  id          Int               @id @default(autoincrement())
  clientId    Int               @map("client_id")
  status      OrderStatus       @default(new)
  source      OrderSource?
  deadline    DateTime?         @db.Date
  note        String?
  urgent      Boolean           @default(false)
  discount    Decimal           @default(0) @db.Decimal(5, 2)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  client      Client            @relation(fields: [clientId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  shipment    Shipment? // звʼязок 1:1
  assignments OrderAssignment[]

  @@index([clientId])
  @@index([status])
  // Додано в ЛР3 під фільтрацію за дедлайном та сортування за датою створення.
  @@index([deadline])
  @@index([createdAt])
  @@map("orders")
}

/// Позиція замовлення (конкретний виріб). Може посилатися на заготовку
/// зі складу (опційно) і має набір виробничих стадій (1:N).
model OrderItem {
  id          Int               @id @default(autoincrement())
  orderId     Int               @map("order_id")
  stockItemId Int?              @map("stock_item_id")
  type        String // тип виробу: медаль, нагорода, плакетка...
  qty         Int               @default(1)
  price       Decimal           @default(0) @db.Decimal(10, 2)
  discount    Decimal           @default(0) @db.Decimal(5, 2)
  details     String?
  sortOrder   Int               @default(0) @map("sort_order")

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockItem   StockItem?        @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  stages      ProductionStage[]

  @@index([orderId])
  @@map("order_items")
}

/// Виробнича стадія позиції (друк, різка, фарбування, запайка...).
/// Належить позиції; виконавець — опційний працівник.
model ProductionStage {
  id          Int         @id @default(autoincrement())
  orderItemId Int         @map("order_item_id")
  stage       String // назва стадії
  status      StageStatus @default(pending)
  executorId  Int?        @map("executor_id")
  note        String?
  updatedAt   DateTime    @updatedAt @map("updated_at")

  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  executor    Employee?   @relation(fields: [executorId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@map("production_stages")
}

/// Оплата за замовлення. Одне замовлення — багато оплат (1:N).
model Payment {
  id      Int           @id @default(autoincrement())
  orderId Int           @map("order_id")
  amount  Decimal       @db.Decimal(12, 2)
  method  PaymentMethod @default(manual)
  sender  String?
  purpose String?
  paidAt  DateTime      @default(now()) @map("paid_at")

  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  // Додано в ЛР3 під сортування та фільтрацію оплат за датою.
  @@index([paidAt])
  @@map("payments")
}

/// Доставка замовлення. Звʼязок 1:1 (одне замовлення — максимум одна доставка).
model Shipment {
  id      Int     @id @default(autoincrement())
  orderId Int     @unique @map("order_id")
  method  String?
  address String?
  ttn     String? // номер ТТН перевізника
  notes   String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

/// Таблиця звʼязку M:N між замовленнями та працівниками з роллю участі.
model OrderAssignment {
  id         Int          @id @default(autoincrement())
  orderId    Int          @map("order_id")
  employeeId Int          @map("employee_id")
  role       EmployeeRole

  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([orderId, employeeId, role])
  @@map("order_assignments")
}

// ─────────────────────── Аутентифікація та файли (ЛР2) ───────────────────────

/// Користувач системи. Пароль зберігається лише у вигляді Argon2id-хешу.
/// Один користувач може мати багато refresh-токенів (різні пристрої/сесії)
/// та завантажувати багато файлів (1:N).
model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  passwordHash String         @map("password_hash")
  fullName     String         @map("full_name")
  role         UserRole       @default(user)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  files         File[]
  activities    ActivityLog[]
  notifications Notification[]

  @@map("users")
}

/// Refresh-токен. На сервері зберігається лише ХЕШ токена (sha-256), тож навіть
/// за витоку бази самі токени відновити не можна. Підтримує відкликання
/// (revokedAt) і ротацію (replacedById вказує на токен, що прийшов на заміну).
model RefreshToken {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  replacedById  Int?      @map("replaced_by_id")
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Метадані завантаженого файлу. Сам файл лежить у теці uploads/ під згенерованим
/// (безпечним) імʼям; у базі зберігаються лише метадані та власник.
model File {
  id           Int      @id @default(autoincrement())
  ownerId      Int      @map("owner_id")
  originalName String   @map("original_name")
  storedName   String   @unique @map("stored_name")
  mimeType     String   @map("mime_type")
  size         Int
  createdAt    DateTime @default(now()) @map("created_at")

  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("files")
}

/// Журнал дій користувачів (рівень 3): хто, яку дію, над чим і коли виконав.
/// Власник може бути null, якщо дію виконано до аутентифікації (напр. невдалий вхід).
model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String // напр. 'user.login', 'file.upload', 'order.delete'
  detail    String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("activity_logs")
}

// ─────────────────────── Сповіщення реального часу (ЛР3) ───────────────────────

/// Сповіщення користувача. Зберігається в БД (щоб не губилося між сесіями) і
/// одночасно доставляється в реальному часі через WebSocket. Має тип, пріоритет
/// та позначку прочитання.
model Notification {
  id        Int                  @id @default(autoincrement())
  userId    Int                  @map("user_id")
  type      NotificationType     @default(system)
  priority  NotificationPriority @default(normal)
  title     String
  body      String?
  data      String? // довільне корисне навантаження у форматі JSON (напр. orderId)
  readAt    DateTime?            @map("read_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Складений індекс під головний запит «мої непрочитані, найновіші зверху».
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}
