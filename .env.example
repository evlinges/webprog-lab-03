# --- Підключення до PostgreSQL ---
# Формат: postgresql://КОРИСТУВАЧ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА?schema=public
DATABASE_URL="postgresql://webprog:webprog@localhost:5433/rezanok_lab?schema=public"

# --- Налаштування HTTP-сервера ---
PORT=3000
NODE_ENV=development

# Дозволені джерела для CORS (через кому), або * для всіх
CORS_ORIGIN=*
# Адреса клієнта для CORS WebSocket-з'єднань (на хостингу — домен фронтенду)
FRONTEND_URL=*

# --- JWT (секрети згенеруйте командою) ---
# node -p "require('node:crypto').randomBytes(32).toString('hex')"
JWT_ACCESS_SECRET=замініть_на_випадковий_рядок_32_байти_hex
JWT_REFRESH_SECRET=замініть_на_інший_випадковий_рядок_32_байти_hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Завантаження файлів ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# --- Обмеження частоти запитів ---
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
